# Prepend the nearest node_modules/.bin to PATH for the current directory tree.
# Static PATH entries cannot do this: the directory is per-project and changes on cd.

_df_sync_node_modules_bin() {
  local bin="" dir="$PWD" candidate part new_path=""

  while [ -n "$dir" ] && [ "$dir" != "/" ]; do
    candidate="$dir/node_modules/.bin"
    if [ -d "$candidate" ]; then
      bin="$candidate"
      break
    fi
    dir="${dir%/*}"
  done

  if [ -n "${ZSH_VERSION:-}" ]; then
    for part in "${path[@]}"; do
      [ -z "$part" ] && continue
      case "$part" in
        */node_modules/.bin) continue ;;
      esac
      new_path="${new_path:+$new_path:}$part"
    done
  else
    local oifs="$IFS"
    IFS=:
    for part in $PATH; do
      [ -z "$part" ] && continue
      case "$part" in
        */node_modules/.bin) continue ;;
      esac
      new_path="${new_path:+$new_path:}$part"
    done
    IFS="$oifs"
  fi

  if [ -n "$bin" ]; then
    PATH="$bin:$new_path"
  else
    PATH="$new_path"
  fi
  export PATH
}

if [ -n "${ZSH_VERSION:-}" ]; then
  autoload -Uz add-zsh-hook
  add-zsh-hook -D precmd _df_sync_node_modules_bin 2>/dev/null
  add-zsh-hook precmd _df_sync_node_modules_bin
elif [ -n "${BASH_VERSION:-}" ]; then
  case ";${PROMPT_COMMAND-};" in
    *"_df_sync_node_modules_bin"*) ;;
    *) PROMPT_COMMAND="_df_sync_node_modules_bin${PROMPT_COMMAND:+;}${PROMPT_COMMAND-}" ;;
  esac
fi

_df_sync_node_modules_bin
