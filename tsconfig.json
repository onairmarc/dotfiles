{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "jsx": "preserve",
        "jsxImportSource": "@opentui/solid",
        "lib": [
            "ESNext"
        ],
        "module": "ESNext",
        "moduleDetection": "force",
        "moduleResolution": "bundler",
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ESNext",
        "types": [
            "bun"
        ],
        "verbatimModuleSyntax": true
    },
    "include": [
        "**/*.ts",
        "opencode/plugins/custom/**/*.tsx"
    ]
}
