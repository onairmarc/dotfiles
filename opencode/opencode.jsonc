{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": true,
    "permission": {
        "bash": {
            "*": "allow",
            "git push": "deny",
            "git push *": "deny",
            "git checkout": "deny",
            "git checkout *": "deny",
            "git reset": "deny",
            "git reset *": "deny",
            "git clean": "deny",
            "git clean *": "deny",
            "git restore": "deny",
            "git restore *": "deny",
            "git stash drop": "deny",
            "git stash drop *": "deny",
            "git stash clear": "deny",
            "git stash clear *": "deny",
            "git switch": "deny",
            "git switch *": "deny",
            "gh pr create": "deny",
            "gh pr create *": "deny",
            "gh pr edit": "deny",
            "gh pr edit *": "deny",
            "gh pr merge": "deny",
            "gh pr merge *": "deny",
            "gh pr ready": "deny",
            "gh pr ready *": "deny",
            "gh pr comment": "deny",
            "gh pr comment *": "deny",
            "gh issue create": "deny",
            "gh issue create *": "deny",
            "gh issue edit": "deny",
            "gh issue edit *": "deny",
            "gh issue comment": "deny",
            "gh issue comment *": "deny",
            "gh release create": "deny",
            "gh release create *": "deny"
        }
    },
    "agent": {
        "general": {
            "model": "openai/gpt-5.6-luna"
        },
        "explore": {
            "model": "openai/gpt-5.6-luna"
        },
        "scout": {
            "model": "openai/gpt-5.6-luna"
        }
    },
    "mcp": {
        "sentry": {
            "type": "remote",
            "url": "https://mcp.sentry.dev/mcp",
            "oauth": {}
        },
        "servicepoint-projects": {
            "type": "remote",
            "url": "https://console.servicepointhq.com/api/v1/mcp/projects",
            "oauth": false,
            "headers": {
                "Authorization": "Bearer {env:SERVICEPOINT_TOKEN}"
            }
        }
    },
    "lsp": {
        "laravel-lsp": {
            "command": [
                "laravel-lsp"
            ],
            "extensions": [
                ".php",
                ".blade.php"
            ]
        }
    },
    // OpenCode Quota: tuiCommandDisplay chooses whether native TUI command output appears in the session transcript or a local popup dialog.
    // OpenCode Quota: loads the server plugin for slash commands and quota checks.
    "plugin": [
        "@slkiser/opencode-quota@latest"
    ],
    "enabled_providers": [
        "openai",
        "xai"
    ],
    "provider": {
        // Detected copilot authentication; opencode-quota added this global provider declaration.
        "copilot": {},
        // Detected xai authentication; opencode-quota added this global provider declaration.
        "xai": {}
    }
}
