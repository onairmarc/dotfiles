{
    "$schema": "https://opencode.ai/v2/config.json",
    "update": "auto",
    "default_agent": "build",
    "agents": {
        "title": {
            "model": "openai/gpt-5.6-luna"
        },
        "general": {
            "model": "openai/gpt-5.6-luna#high"
        },
        "explore": {
            "model": "openai/gpt-5.6-terra"
        },
        "scout": {
            "model": "openai/gpt-5.6-luna"
        }
    },
    "experimental": {
        "subagent_depth": 3,
        "policies": [
            {
                "action": "provider.use",
                "resource": "*",
                "effect": "deny"
            },
            {
                "action": "provider.use",
                "resource": "openai",
                "effect": "allow"
            },
            {
                "action": "provider.use",
                "resource": "xai",
                "effect": "allow"
            },
            {
                "action": "provider.use",
                "resource": "opencode",
                "effect": "allow"
            }
        ]
    },
    "mcp": {
        "servers": {
            "sentry": {
                "type": "remote",
                "url": "https://mcp.sentry.dev/mcp",
                "oauth": {}
            },
            "servicepoint": {
                "type": "remote",
                "url": "https://console.servicepointhq.com/api/v1/mcp",
                "oauth": false,
                "headers": {
                    "Authorization": "Bearer {env:SERVICEPOINT_TOKEN}"
                }
            },
            "epp": {
                "type": "remote",
                "url": "https://portal.encoredigitalgroup.com/api/v1/mcp",
                "oauth": false,
                "headers": {
                    "Authorization": "Bearer {env:EPP_TOKEN}"
                }
            }
        }
    },
    // OpenCode Quota: tuiCommandDisplay chooses whether native TUI command output appears in the session transcript or a local popup dialog.
    // OpenCode Quota: loads the server plugin for slash commands and quota checks.
    "plugins": [
        {
            "package": "@encoredigitalgroup/opencode@latest",
            "options": {}
        },
        {
            "package": "@slkiser/opencode-quota@latest",
            "options": {}
        }
    ],
    "providers": {
        "xai": {},
        "openai": {}
    },
    "permissions": [
        {
            "action": "shell",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git push *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git checkout *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git reset *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git clean *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git restore *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git stash drop *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git stash clear *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git switch *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "gh pr create *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "gh pr edit *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "gh pr merge *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "gh pr ready *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "gh pr comment *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "gh issue create *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "gh issue edit *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "gh issue comment *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "gh release create *",
            "effect": "deny"
        }
    ]
}
