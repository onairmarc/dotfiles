{
    "$schema": "https://opencode.ai/v2/cli.json",
    "theme": {
        "name": "opencode"
    },
    "keybinds": {
        "session.child.first": "alt+down",
        "prompt.queue": [
            "ctrl+shift+return",
            "super+shift+return"
        ]
    },
    "session": {
        "grouping": "none",
        "thinking": "show"
    },
    "tabs": {
        "mode": "off"
    }
}
